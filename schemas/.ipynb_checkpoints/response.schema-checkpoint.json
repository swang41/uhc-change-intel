{
  "type": "object",
  "required": [
    "decision",
    "validity_window",
    "evidence"
  ],
  "properties": {
    "decision": {
      "type": "string",
      "enum": [
        "Covered",
        "RequiresPA",
        "NotCovered",
        "Ambiguous"
      ]
    },
    "validity_window": {
      "type": "object",
      "required": [
        "effective_from"
      ],
      "properties": {
        "effective_from": {
          "type": "string"
        },
        "effective_to": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "policy_id",
          "section",
          "page",
          "quote"
        ],
        "properties": {
          "policy_id": {
            "type": "string"
          },
          "section": {
            "type": "string"
          },
          "page": {
            "type": "integer"
          },
          "quote": {
            "type": "string"
          }
        }
      }
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "section",
          "old",
          "new"
        ],
        "properties": {
          "section": {
            "type": "string"
          },
          "old": {
            "type": "string"
          },
          "new": {
            "type": "string"
          }
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}