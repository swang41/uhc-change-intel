# ── Local mode (no GCP required) ────────────────────────────────────────────
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ── GCP / Vertex AI (--mode gcp) ────────────────────────────────────────────
PROJECT_ID=
LOCATION=us-central1
RAG_CORPUS=uhc-coverage-change-corpus

# === Models & knobs ===
RERANK_MODEL=gemini-1.5-pro

# === Optional auth: prefer ADC (gcloud auth application-default login) ===
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# === Tuning (optional) ===
TOP_K_DENSE=20
MMR_LAMBDA=0.7
RERANK_TOP=5
